            <div class="container-xxl my-md-5">
                <div class="page-related-links d-flex justify-content-start align-items-center gap-2" id="related-links-3fss86toqwdmu49k" style="display:none;"></div>
<script>
    (function() {
        var pageId  = '3fss86toqwdmu49k';
        var pageUrl = '/sports/mbkb/2025-26/Rosters_2025-26/LASC_Roster_2025-2026.pdf';

        function buildAriaLabel(label, relatedEvt) {
            if (!relatedEvt) return label;
            var a = relatedEvt.sport + ' event: ' + relatedEvt.date + ' ';
            if (relatedEvt.team1) {
                a += relatedEvt.team1;
                if (relatedEvt.team2) { a += ' ' + relatedEvt.ariaVsOrAt + ' ' + relatedEvt.team2; }
                a += ':';
            }
            if (relatedEvt.neutralSite) { a += ' @ ' + relatedEvt.neutralSite + ':'; }
            a += ' ' + label;
            return a;
        }

        let url = '/action/content/scheduleRelatedLinks.json?pageId=' + encodeURIComponent(pageId) + '&pageUrl=' + encodeURIComponent(pageUrl);
        fetch(url).then(res => res.json()).then(relatedEvts => {
            var relatedEvt;
            var relatedEvtLinks;
            if (relatedEvts && relatedEvts.length > 0) {
                relatedEvt = relatedEvts[0];
                if (relatedEvt.links && relatedEvt.links.length > 0) {
                    relatedEvtLinks = relatedEvt.links;
                }
                relatedEvt.ariaVsOrAt = (relatedEvt.neutralSite && relatedEvt.neutralSite.length > 0) || relatedEvt.home ? 'vs.' : 'at';
            }

            url = '/action/content/relatedLinks.json?pageId=' + encodeURIComponent(pageId);
            fetch(url).then(res => res.json()).then(links => {
                if (!links || links.length === 0) { return; }

                var eventLinks = relatedEvtLinks || [];
                var printed = {};
                var parts   = [];
                for (var i = 0; i < links.length; i++) {
                    var id = links[i].id;
                    var text = links[i].text;
                    var url = links[i].url;
                    var mapType = links[i].mapType;

                    // Apply event-link override
                    for (var j = 0; j < eventLinks.length; j++) {
                        if (eventLinks[j].url === url) {
                            text = eventLinks[j].text;
                            url = eventLinks[j].url;
                            mapType = eventLinks[j].mapType;
                            break;
                        }
                    }

                    var counter = printed.hasOwnProperty(text) ? printed[text] + 1 : 1;
                    var label = counter > 1 ? text + ' ' + counter : text;
                    printed[text] = counter;

                    var item;
                    var ariaLabel = buildAriaLabel(label, relatedEvt);
                    var isExternal = (url.indexOf('http') === 0 || url.indexOf('/links') === 0) &&
                            url.indexOf(window.location.host) === -1;
                    var cssClass = "btn btn-link border text-decoration-none btn-sm" + (pageId === id ? " active" : "");
                    var icon = '';
                    switch(mapType) {
                        case "GA":                             icon = '<span class="far fa-images"></span>';
                            break;
                        case "TI":                             icon = '<span class="fas fa-ticket-alt"></span>';
                            break;
                        case "RC":                             icon = '<span class="fa fa-share"></span>';
                            break;
                        case "PR":                             icon = '<span class="far fa-eye"></span>';
                            break;
                        case "LS":                             icon = '<span class="fas fa fa-chart-simple"></span>';
                            break;
                        case "VI":                             icon = '<span class="fa fa-video-camera"></span>';
                            break;
                        case "AU":                             icon = '<span class="fas fa-headphones-alt"></span>';
                            break;
                        case "DI":                             icon = '<span class="fas fa-directions"></span>';
                            break;
                        case "BS":                             icon = '<span class="far fa-chart-bar"></span>';
                            break;
                        case "RE":                             icon = '<span class="fa fa-calculator"></span>';
                            break;
                        case "LI":                             icon = '<span class="fa fa-external-link"></span>';
                            break;
                    }
                    item = '<a href="' + url + '" aria-label="' + ariaLabel + '"' + ' class="' + cssClass + '"' +
                            (isExternal ? ' target="_blank"' : '') + '>'
                            + icon
                            + '<span class="recap-label"> ' + text + '</span>'
                            + '</a>';
                    parts.push(item);
                }

                var container = document.getElementById('related-links-' + pageId);
                if (container && parts.length > 0) {
                    container.innerHTML = parts.join('');
                    container.style.display = '';
                }
            });
        });
    })();
</script>
 


 
